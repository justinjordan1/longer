# Supabase (public — safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Letter email notifications.
# Without RESEND_API_KEY the app runs exactly as before: letters are delivered
# to the mailroom and no email is attempted.
RESEND_API_KEY=
# Must be a domain verified in Resend.
LETTER_EMAIL_FROM="LONGER <letters@longerwords.com>"
# Absolute base for links in email. Falls back to longerwords.com in
# production, the Vercel preview URL otherwise.
NEXT_PUBLIC_SITE_URL=https://longerwords.com

# Server-only. Reads the recipient's address from auth.users and signs
# unsubscribe tokens. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
